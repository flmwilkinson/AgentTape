# Production .env for the Hetzner deploy.
# Copy to .env at the repo root (/opt/agenttape/.env), chmod 600,
# fill in real values, never commit.

# -------- Neon Postgres (Decision: data lives off-VPS) --------
# Get this from https://console.neon.tech → your project → Connection Details
# IMPORTANT: convert the asyncpg-style URL by replacing
#   postgresql://USER:PASS@HOST/DB
# with
#   postgresql+asyncpg://USER:PASS@HOST/DB?sslmode=require
# (alembic auto-coerces +asyncpg → +psycopg for migrations.)
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST.neon.tech/agenttape?sslmode=require

# -------- Discovery / ingestion API keys --------
# Rotate every one of these BEFORE pasting (the previous values were
# exposed in chat — treat them as compromised). Sources:
#   https://github.com/settings/tokens                (PAT, repo:read)
#   https://huggingface.co/settings/tokens            (read-only)
#   https://console.anthropic.com/settings/keys
#   https://www.voyageai.com/                          (optional, vibe search)
#   https://stackapps.com/apps/oauth                   (optional, raises SO quota)
#   https://bsky.app/settings/app-passwords            (NOT your login)
#   https://api.producthunt.com/v2/oauth/applications
GITHUB_TOKEN=
HUGGINGFACE_TOKEN=
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
STACKEXCHANGE_KEY=
BLUESKY_HANDLE=
BLUESKY_APP_PASSWORD=
PRODUCT_HUNT_TOKEN=

# Citations — OpenAlex polite pool. Any email you check works.
OPENALEX_MAILTO=

# -------- Optional Reddit (currently empty in your laptop env) --------
# Register at https://www.reddit.com/prefs/apps as a "script" app.
# Without these the reddit_*_7d ingestors soft-skip; the score
# pipeline still works — it just won't carry Reddit signals.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=agenttape/1.0
