# Local dev defaults — these are the values when you run the app
# against your local docker-compose stack.
NEXT_PUBLIC_API_URL=http://localhost:8001
NEXT_PUBLIC_REALTIME_URL=ws://localhost:8002

# Public-facing site URL — feeds into <link rel="canonical">,
# the OpenGraph meta, the sitemap, the RSS feed, and the badge
# snippets. Override on Vercel to your real domain.
#   NEXT_PUBLIC_SITE_URL=https://agenttape.com

# Production values to set in Vercel (do NOT put these here):
#   NEXT_PUBLIC_API_URL=https://api.agenttape.com
#   NEXT_PUBLIC_REALTIME_URL=wss://ws.agenttape.com
#   NEXT_PUBLIC_SITE_URL=https://agenttape.com
