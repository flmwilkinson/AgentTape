{
  "_README": [
    "Manual mapping of agent slug -> { ecosystem: package-name }.",
    "Discovery's auto-detect catches GitHub repos that ship a single",
    "package.json, but flagship apps with monorepos / private npm",
    "scopes / non-default branches need explicit hints. Add entries",
    "here when you spot a missing npm_weekly / pypi_monthly signal",
    "on a high-profile agent.",
    "",
    "Idempotent: rerunning seed_package_names.py merges into",
    "agents.package_names rather than replacing it. Keys are 'npm',",
    "'pypi', 'docker', 'crates' — same names the ingestion sources",
    "look up."
  ],
  "claude-code": { "npm": "@anthropic-ai/claude-code" },
  "cline": { "npm": "@cline/cli" },
  "aider": { "pypi": "aider-chat" },
  "continue": { "npm": "@continuedev/cli" },
  "browser-use": { "pypi": "browser-use" },
  "opencode": { "npm": "@opencode-ai/cli" },
  "gptme": { "pypi": "gptme" },
  "letta": { "pypi": "letta" },
  "praisonai": { "pypi": "praisonai" },
  "deer-flow": { "npm": "deer-flow" },
  "nanobot": { "npm": "nanobot" },
  "harness": { "pypi": "harness-test" },
  "career-ops": { "npm": "career-ops" },
  "codeinterpreter-api": { "pypi": "codeinterpreter-api" },
  "code-act": { "pypi": "code-act" },
  "cherry-studio": { "npm": "cherry-studio" },
  "activepieces": { "npm": "@activepieces/cli" },
  "composio": { "pypi": "composio-core", "npm": "composio-core" },
  "claude-mem": { "npm": "claude-mem" },
  "agent-reach": { "npm": "agent-reach" }
}
